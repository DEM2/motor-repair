# Variables para ejecutar business-service FUERA de Docker (uvicorn --reload).
# Copia este archivo como business-service/.env
# Dentro de Docker Compose estas variables las inyecta docker-compose.yml.

APP_ENV=development

# Base de datos propia del servicio (solo business_user tiene acceso a business_db)
DATABASE_URL=postgresql+psycopg://business_user:change-me-business@localhost:5432/business_db

# JWT: este servicio SOLO necesita la llave PÚBLICA (verifica, nunca firma)
JWT_PUBLIC_KEY_PATH=../keys/jwt_public.pem
# Alternativa para CI o la nube: JWT_PUBLIC_KEY con el contenido PEM (saltos de línea como \n)
JWT_ISSUER=motor-repair-auth
JWT_AUDIENCE=motor-repair-api

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
