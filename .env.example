# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores.
#   cp .env.example .env
# NUNCA subas el .env ni las llaves de ./keys al repositorio.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (superusuario, solo lo usa el contenedor de BD) ─
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5434

# ── Base de datos del servicio de autenticación ───────────────
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me-auth

# ── Base de datos del servicio de negocio ─────────────────────
BUSINESS_DB_NAME=business_db
BUSINESS_DB_USER=business_user
BUSINESS_DB_PASSWORD=change-me-business

# ── JWT (RS256) ───────────────────────────────────────────────
# Genera el par de llaves con: ./scripts/generate-keys.sh
# El servicio de auth usa la PRIVADA (firma); el de negocio solo la PÚBLICA (verifica).
JWT_ISSUER=motor-repair-auth
JWT_AUDIENCE=motor-repair-api
JWT_EXPIRES_IN=1h

# ── Puertos expuestos ─────────────────────────────────────────
AUTH_PORT=4000
BUSINESS_PORT=8000
FRONTEND_PORT=5173

# ── Usuario administrador inicial (seed del servicio de auth) ─
ADMIN_EMAIL=admin@taller.local
ADMIN_PASSWORD=change-me-Admin123
